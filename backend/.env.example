# PhishGuard AI - Backend Environment Configuration

# Google Gemini API Key (Get one from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to enable mock heuristic analysis without a real Gemini API key
DEMO_MODE=false
